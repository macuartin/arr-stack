# ─────────────────────────────────────────────────────────────
# Media library (contenido descargado, hardlinks) — nunca versionar
# ─────────────────────────────────────────────────────────────
media/

# ─────────────────────────────────────────────────────────────
# Configuración VIVA de cada servicio (*arr / plex / etc.)
# Contiene SECRETOS: API keys, contraseñas, tokens de Plex,
# credenciales de indexers y bases de datos SQLite.
# TODO ignorado por defecto (denylist); las copias versionables
# se generan sanitizadas en configs/ con scripts/config-backup.sh
# ─────────────────────────────────────────────────────────────
*/config/

# Excepción recyclarr: no reescribe su config y soporta secrets.yml,
# así que se versiona in-place con allowlist explícita archivo a archivo.
!recyclarr/config/
recyclarr/config/*
!recyclarr/config/recyclarr.yml
!recyclarr/config/settings.yml
!recyclarr/config/secrets.yml.example
# cinturón y tirantes: ya lo ignora recyclarr/config/*, pero explícito
recyclarr/config/secrets.yml

# Snapshots sanitizados (generados; SÍ versionados)
!configs/

# ─────────────────────────────────────────────────────────────
# Variables de entorno (PUID/PGID/TZ y cualquier secreto local)
# ─────────────────────────────────────────────────────────────
.env
*.env
!.env.example

# ─────────────────────────────────────────────────────────────
# Ruido del sistema
# ─────────────────────────────────────────────────────────────
*.log
*.pid
.DS_Store
Thumbs.db
